void setup() {
  Serial.begin(9600);    // Inicializa el puerto serie
  pinMode(trig, OUTPUT); // Configura el pin Trig como salida
  pinMode(echo, INPUT);  // Configura el pin Echo como entrada

  // Iniciar la pantalla OLED en la dirección I2C 0x3C
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println(F("Fallo al encontrar la pantalla OLED"));
    while (true);
  }

  // Limpiar búfer
  display.clearDisplay();

  // Configurar texto por si decides usarlo luego
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 10);

  // Mostrar la imagen del robot centrada y ocupando el lienzo
  display.drawBitmap(0, 0, autito , 128, 64, SSD1306_WHITE);
  display.display();
}

void loop() {
  digitalWrite(trig, HIGH);
  delayMicroseconds(10);
  digitalWrite(trig, LOW);

  int t = pulseIn(echo, HIGH);
  int d = t / 59;
  Serial.println(d);

  if (d == 0) {
    d = 100;
  }

  if (d < 15) {
    display.clearDisplay();
    display.drawBitmap(0, 0, autito , 128, 64, SSD1306_WHITE);
    display.display();
  } else {
    display.clearDisplay();
    display.drawBitmap(0, 0, keke , 128, 64, SSD1306_WHITE);
    display.display();
  }
}
